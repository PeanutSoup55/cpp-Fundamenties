#include <iostream>
using namespace std;

int calc(int arr[], int size) {
    int total = 0;
    for (int i = 0; i < size; i++){
        total = arr[i] + total;
    }
    return total;
}

int main() {
    int arr[] = {1, 2, 3, 4, 5};
    int size = sizeof(arr) / sizeof(arr[0]);
    cout << calc(arr, size) << endl;
    return 0;
}